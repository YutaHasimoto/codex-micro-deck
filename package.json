{
  "name": "codex-micro-deck",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "description": "A Stream Deck + control surface for the Codex desktop app.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c --forceExit",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.local.codexmicrodeck\"",
    "profile:generate": "node scripts/generate-plus-profile.mjs",
    "profile:check": "node scripts/generate-plus-profile.mjs --check",
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.ts",
    "validate": "node scripts/validate.mjs",
    "validate:sdk": "streamdeck validate --no-update-check com.local.codexmicrodeck.sdPlugin",
    "check": "npm run build && npm run test && npm run profile:check && npm run validate && npm run validate:sdk",
    "pack": "npm run check && streamdeck pack --force --no-update-check --output dist-v0.4.8-final com.local.codexmicrodeck.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0"
  }
}
