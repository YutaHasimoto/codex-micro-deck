{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "Codex タスク",
      "UUID": "com.local.codexmicrodeck.key",
      "Icon": "imgs/action-key",
      "Tooltip": "Codexタスクを開く、または安全なコマンドを実行します。",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/action-key",
          "ShowTitle": false,
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Codex 操作ダイヤル",
      "UUID": "com.local.codexmicrodeck.encoder",
      "Icon": "imgs/action-encoder",
      "Tooltip": "回転でモデル・推論・速度・Accessを新規既定値と次のターン用Agentタスクへ同期し、押下でCodexの音声入力を開始・送信します。",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/action-encoder",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "Icon": "imgs/action-encoder",
        "layout": "layouts/encoder.json",
        "StackColor": "#304FFE",
        "TriggerDescription": {
          "Rotate": "候補を選ぶ（停止80ms後に全Agentへ同期・音声入力中は無効）",
          "Push": "音声入力を開始／もう一度押して文字起こし・送信",
          "Touch": "設定再読込（長押しで既定値へ戻す）"
        }
      }
    }
  ],
  "ApplicationsToMonitor": {
    "mac": [
      "com.openai.codex"
    ]
  },
  "Author": "Local",
  "Category": "Codex Micro Deck",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Stream Deck +のすべてのキー、ダイヤル、タッチ領域からCodexを操作します。",
  "Icon": "imgs/plugin-icon",
  "Name": "Codex Micro Deck",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13.0"
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/Codex Micro Deck",
      "DeviceType": 7,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": false
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.local.codexmicrodeck",
  "Version": "0.4.8.0"
}